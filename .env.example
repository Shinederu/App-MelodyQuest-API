# MelodyQuest DB env vars (for PHP runtime)
MQ_DB_TYPE=mysql
MQ_DB_HOST=mysql-server
MQ_DB_NAME=ShinedeCore
MQ_DB_USER=MelodyQuestUser
MQ_DB_PASS=change_me
MQ_DB_PORT=3306

# Auth API used to rebuild uploaded avatar URLs exposed by MelodyQuest
MQ_AUTH_BASE_API=https://api.shinederu.ch/auth/

# Session invitee glissante (aucun compte users n'est cree)
MQ_GUEST_SESSION_TTL_SECONDS=7200
MQ_GUEST_SESSION_TOUCH_INTERVAL_SECONDS=300

# Default answer validation threshold for newly created lobbies
MQ_DEFAULT_ANSWER_SIMILARITY_THRESHOLD=80

# Anti-répétition entre les parties des joueurs présents
MQ_TRACK_REPEAT_LOOKBACK_DAYS=30
MQ_TRACK_REPEAT_STRICT_DAYS=7
MQ_TRACK_REPEAT_HISTORY_LIMIT=500

# Mercure hub (same runtime .env as auth)
MERCURE_HUB_URL=https://mercure.shinederu.ch/.well-known/mercure
MERCURE_PUBLISH_URL=http://mercure/.well-known/mercure
MERCURE_PUBLISHER_JWT_KEY=change_me
MERCURE_SUBSCRIBER_JWT_KEY=change_me
MQ_MERCURE_TOPIC_BASE=https://api.shinederu.ch/melodyquest/topics
MQ_MERCURE_COOKIE_DOMAIN=.shinederu.ch
MQ_MERCURE_COOKIE_PATH=/.well-known/mercure
MQ_MERCURE_SUBSCRIBER_TTL_SECONDS=90
MQ_MERCURE_PUBLISH_TIMEOUT_SECONDS=1
MQ_REALTIME_OUTBOX_BATCH_SIZE=8
MQ_REALTIME_OUTBOX_MAX_RUNTIME_MS=2000
MQ_REALTIME_OUTBOX_LOCK_TIMEOUT_SECONDS=30

